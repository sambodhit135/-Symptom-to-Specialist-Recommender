# =============================================================================
# .env.example – Environment variable template for docker-compose.yml
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# NEVER commit .env to version control (it is strictly ignored in .gitignore).

# ── Compose Profiles ─────────────────────────────────────────────────────────
# Which services to start by default when running `docker compose up -d`:
#   core       - api + frontend + mlflow (essential inference & tracking, ~2.6 GB RAM)
#   monitoring - prometheus + grafana (~235 MB RAM)
#   full       - all 5 services (core + monitoring, ~2.85 GB RAM)
COMPOSE_PROFILES=full

# ── Frontend Web UI ──────────────────────────────────────────────────────────
# Host port for the single-page vanilla JS UI and nginx API reverse proxy.
# Browser URL: http://localhost:8080
FRONTEND_PORT=8080

# ── FastAPI Prediction Service ───────────────────────────────────────────────
# Host port for the FastAPI prediction backend.
# URL: http://localhost:8000 | Docs: http://localhost:8000/docs
API_PORT=8000

# Tracking URI used by FastAPI to log runs or load production model registry.
# Inside Docker network, points to the container name: http://mlflow:5000.
MLFLOW_TRACKING_URI=http://mlflow:5000

# Administrative API key for protected routes (e.g. POST /admin/reload-model).
# Must be passed as header: X-API-Key: <ADMIN_API_KEY>
ADMIN_API_KEY=admin-secret-reload-key

# ── MLflow Tracking Service ──────────────────────────────────────────────────
# Host port for the MLflow tracking UI.
# URL: http://localhost:5000
MLFLOW_PORT=5000

# SQLite backend storage URI inside the container (backed by named volume mlflow_data).
MLFLOW_BACKEND_URI=sqlite:////mlflow_data/mlflow.db

# ── Monitoring & Observability Services ──────────────────────────────────────
# Host port for Prometheus time-series metrics server.
# URL: http://localhost:9090
PROMETHEUS_PORT=9090

# Host port for Grafana metrics visualization dashboards.
# URL: http://localhost:3000
GRAFANA_PORT=3000

# Grafana admin initial password.
GRAFANA_ADMIN_PASSWORD=admin

# ── Persistent Storage Directories (inside containers) ───────────────────────
# Mapped to Docker named volumes: feedback_data and prod_logs_data.
FEEDBACK_DIR=/app/data/feedback
PROD_LOGS_DIR=/app/data/prod_logs

# ── Optional Pipeline Services (Airflow Orchestration) ───────────────────────
# Default to 8088 to avoid colliding with frontend port 8080.
AIRFLOW_PORT=8088
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_SECRET_KEY=468164f9b2d973715d38c642289c89e2
