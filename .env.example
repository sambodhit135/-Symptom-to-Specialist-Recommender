# =============================================================================
# .env.example – Environment variable template for docker-compose.yml
# =============================================================================
# Copy this file to .env and adjust values for your deployment.
# NEVER commit .env to version control (it is in .gitignore).

# ── API Service ──────────────────────────────────────────────────────────────
# Port the API is exposed on the host machine
API_PORT=8000

# Set to the MLflow tracking URI if you want the API to load models from the
# MLflow registry at runtime. Leave blank to use models/production/ on disk
# (the default – no MLflow server required for inference).
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── MLflow Tracking Service ──────────────────────────────────────────────────
# Host port for the MLflow UI
MLFLOW_PORT=5000

# SQLite database file path inside the mlflow container
MLFLOW_BACKEND_URI=sqlite:////mlflow_data/mlflow.db

# ── Application Directories (inside container) ────────────────────────────────
# These are mounted as Docker named volumes; override only if needed.
FEEDBACK_DIR=/app/data/feedback
PROD_LOGS_DIR=/app/data/prod_logs
