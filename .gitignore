# Python venv
venv/
.venv/
env/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.pyo

# Environment / secrets
.env
.env.*

# Docker secrets (keep .env.example)
!.env.example

# MLflow artefacts
mlflow.db
mlruns/
mlartifacts/

# Trained model binaries (keep .gitkeep)
models/*.pkl
models/*.joblib

# Reports generated at runtime
reports/*
!reports/drift/
!reports/drift/.gitkeep
# Keep small JSON summaries; exclude large Evidently HTML reports (5+ MB each)
!reports/drift/*.json
reports/drift/*.html


# Feedback and production log data
data/feedback/*
data/prod_logs/*
data/retraining/*

# Keep placeholder files
!data/feedback/.gitkeep
!data/prod_logs/.gitkeep
!data/retraining/.gitkeep

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Jupyter checkpoints
.ipynb_checkpoints/

# Temporary candidate model directory
models/candidate_temp/
