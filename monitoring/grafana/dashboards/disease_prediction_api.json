        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Disease Prediction API",
  "uid": "disease-prediction-api-v1",
  "version": 1
}
